# ==========================================
# Security  (required)
# ==========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_EXP_HOURS=24

# Comma-separated emails auto-promoted to the admin role on register/login.
# You can also use: python seed_admin.py admin@example.com "SuperSecret1"
ADMIN_EMAILS=

# ==========================================
# MongoDB  (required - must include a db name)
# ==========================================
MONGO_URI=mongodb://localhost:27017/ai_knowledge

# ==========================================
# Groq (LLM)  -  https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for currently served models.
GROQ_MODEL=openai/gpt-oss-120b

# ==========================================
# Pinecone (vector DB)  -  https://app.pinecone.io
# Index must be created with dimension 384, metric cosine.
# ==========================================
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_DIMENSION=384

# ==========================================
# Embeddings (runs locally, no API key)
# ==========================================
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=32

# ==========================================
# Retrieval tuning
# ==========================================
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_MIN_SCORE=0.15
RAG_HISTORY_TURNS=3

# ==========================================
# Uploads
# ==========================================
UPLOAD_FOLDER=uploads/documents
MAX_UPLOAD_MB=5

# ==========================================
# CORS - comma-separated frontend origins
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Rate limits (flask-limiter syntax)
# Set RATELIMIT_STORAGE_URI to redis://... when running >1 worker.
# ==========================================
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_AUTH=10 per minute
RATELIMIT_UPLOAD=10 per minute
RATELIMIT_CHAT=20 per minute
RATELIMIT_READ=120 per minute
